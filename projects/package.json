{
  "name": "micro-node-projects",
  "private": true,
  "type": "module",
  "workspaces": ["logging-middleware"],
  "scripts": {
    "db": "prisma db push --skip-generate --schema 07-user-management/prisma/schema.prisma && prisma db push --skip-generate --schema 08-journal-crud/prisma/schema.prisma",
